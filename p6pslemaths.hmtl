<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>P6 Maths Full Pack</title>
<style>
:root{
  --bg1:#fee2e2;
  --bg2:#ede9fe;
  --card:#fff;
  --ink:#0f172a;
  --muted:#475569;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Nunito","Comic Sans MS",sans-serif;
  background:linear-gradient(135deg,var(--bg1),var(--bg2));
  color:var(--ink);
  line-height:1.45;
}
button{font-family:inherit}
.container{max-width:760px;margin:0 auto;padding:16px}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.brand{font-weight:1000;font-size:1.2rem}
.chip{display:inline-block;background:#fee2e2;color:#b91c1c;padding:8px 12px;border-radius:999px;font-weight:900;font-size:.9rem}
.hero{background:linear-gradient(135deg,#dc2626,#7c3aed);color:#fff;padding:20px;border-radius:24px;box-shadow:0 14px 34px rgba(220,38,38,.18)}
.hero h1{margin:0 0 8px;font-size:1.5rem}
.hero p{margin:0;font-weight:700}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:14px 0}
.stat{background:var(--card);border-radius:18px;padding:12px;text-align:center;box-shadow:0 10px 24px rgba(15,23,42,.06)}
.value{font-size:1.4rem;font-weight:1000}
.label{color:var(--muted);font-weight:800;font-size:.9rem}
.card{background:var(--card);border-radius:22px;padding:16px;box-shadow:0 10px 24px rgba(15,23,42,.08);margin:12px 0}
.topic-card{cursor:pointer;border:3px solid transparent;transition:.15s}
.topic-card:active{transform:scale(.99)}
.topic-card:hover{border-color:#fca5a5}
.topic-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.emoji{font-size:2rem}
.topic-title{font-weight:1000;margin:8px 0 4px}
.small{color:var(--muted);font-weight:800;font-size:.9rem}
.progress{height:12px;background:#e2e8f0;border-radius:999px;overflow:hidden;margin:10px 0}
.progress div{height:100%;background:linear-gradient(90deg,#dc2626,#7c3aed)}
.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.btn{border:0;border-radius:16px;padding:12px 16px;font-weight:1000;cursor:pointer}
.primary{background:linear-gradient(135deg,#dc2626,#7c3aed);color:#fff}
.secondary{background:#e2e8f0;color:#0f172a}
.notes{padding-left:20px;margin:10px 0}
.notes li{margin:6px 0;font-weight:700}
.options{display:grid;gap:10px;margin-top:12px}
.option{border:3px solid #fecaca;background:#fffafa;border-radius:18px;padding:14px;font-size:1rem;font-weight:900;text-align:left;cursor:pointer}
.option:disabled{opacity:.95}
.option.correct{background:#ecfdf5;border-color:#10b981}
.option.wrong{background:#fff1f2;border-color:#f43f5e}
.feedback{margin-top:14px;padding:14px;border-radius:18px;font-weight:900}
.feedback.good{background:#ecfdf5;border:2px solid #a7f3d0}
.feedback.bad{background:#fff1f2;border:2px solid #fecdd3}
.exp{margin-top:6px;font-weight:600}
.review-item{border:2px solid #e2e8f0;border-radius:18px;padding:12px;margin:10px 0;background:#fbfdff}
.review-q{font-weight:1000;margin-bottom:6px}
.correct-answer{color:#047857;font-weight:1000}
.user-answer{color:#be123c;font-weight:1000}
.hidden{display:none !important}
.result-stars{font-size:2.2rem;margin:8px 0}
.error-box{background:#fff1f2;border:2px solid #f43f5e;border-radius:16px;padding:16px;font-weight:700;white-space:pre-wrap;font-family:monospace}
</style>
</head>
<body>
<main id="app"></main>

<script>
window.addEventListener("error", function(e){
  const app = document.getElementById("app");
  if (app) {
    app.innerHTML = '<div class="container"><div class="error-box">Page error: ' + (e.message || "Unknown error") + '</div></div>';
  }
});
</script>

<script>
const TOPICS = [
  {
    id: "algebra",
    title: "Algebra",
    emoji: "🔤",
    blurb: "Expressions, equations, substitution and simplification.",
    notes: [
      "Letters stand for numbers.",
      "Solve equations by doing the inverse operation."
    ],
    qs: [
      ["If a = 5, what is 3a + 2?",["17","15","12","20"],"3 × 5 + 2 = 17."],
      ["If x = 4, what is 5x - 6?",["14","20","10","26"],"5 × 4 - 6 = 14."],
      ["Simplify 4p + 3p.",["7p","12p","p","7"],"Add like terms."],
      ["Simplify 9m - 2m.",["7m","11m","7","9m"],"9 - 2 = 7."],
      ["Simplify 2a + 3b + 4a.",["6a + 3b","9a","5a + 3b","6a + 4b"],"Combine the a terms."],
      ["What is y + y + y?",["3y","y3","3","y"],"Three y added together is 3y."],
      ["How is 5 multiplied by n written?",["5n","5 + n","n5 only","5/n"],"Multiplication is written as 5n."],
      ["If 2x = 18, what is x?",["9","36","16","20"],"Divide both sides by 2."],
      ["If x + 7 = 15, what is x?",["8","22","7","15"],"15 - 7 = 8."],
      ["If 3y - 4 = 11, what is y?",["5","7","3","15"],"11 + 4 = 15, 15 ÷ 3 = 5."],
      ["If 4x + 3 = 19, what is x?",["4","16","5","6"],"19 - 3 = 16, 16 ÷ 4 = 4."],
      ["A number increased by 6 is 20. What is the number?",["14","26","6","12"],"20 - 6 = 14."],
      ["A number multiplied by 3 gives 21. What is the number?",["7","18","24","3"],"21 ÷ 3 = 7."],
      ["Ali is x years old. Tom is 3 years older. What is Tom's age?",["x + 3","x - 3","3x","x / 3"],"Older means add."],
      ["Mary has n sweets. She gives away 4. How many are left?",["n - 4","n + 4","4n","4 - n"],"Giving away means subtract."],
      ["Each box has a books. How many books are in 5 boxes?",["5a","a + 5","a/5","5 + a"],"Multiply by 5."],
      ["A pencil costs $x. What is the cost of 4 pencils?",["$4x","$x4 only","$4 + x","$x/4"],"Cost is 4 times x."],
      ["Simplify 2(x + 3).",["2x + 6","2x + 3","x + 6","2x + 5"],"Multiply both terms inside."],
      ["Simplify 4(2y - 1).",["8y - 4","6y - 4","8y - 1","4y - 4"],"4 × 2y = 8y, 4 × 1 = 4."],
      ["If a = 3 and b = 2, what is 2a + 3b?",["12","10","15","9"],"2×3 + 3×2 = 6 + 6 = 12."],
      ["If p = 5, what is p²?",["25","10","52","5"],"p² means p × p."],
      ["If x = 6, what is x/2 + 4?",["7","10","8","5"],"6 ÷ 2 = 3, 3 + 4 = 7."],
      ["Solve x/3 = 6.",["18","2","3","9"],"Multiply both sides by 3."],
      ["Two numbers are x and x + 5. What is their sum?",["2x + 5","x + 5","2x","x + 10"],"x + x + 5 = 2x + 5."],
      ["A rectangle has width w and length w + 2. What is its perimeter?",["4w + 4","2w + 2","4w","w² + 2w"],"Perimeter = 2(w + w + 2)."]
    ]
  },
  {
    id: "ratio",
    title: "Ratio",
    emoji: "⚖️",
    blurb: "Simplifying ratios, dividing quantities and ratio word problems.",
    notes: [
      "A ratio compares quantities.",
      "Use parts to divide totals."
    ],
    qs: [
      ["Simplify 6:9.",["2:3","3:2","6:9","1:2"],"Divide by 3."],
      ["Simplify 12:18.",["2:3","3:2","4:6","6:9"],"Divide by 6."],
      ["Two numbers are in the ratio 4:5. Their total is 45. What is the smaller number?",["20","25","15","30"],"4 + 5 = 9 parts, 45 ÷ 9 = 5, 4 × 5 = 20."],
      ["The ratio of boys to girls is 3:4. There are 12 boys. How many girls?",["16","9","12","20"],"12 ÷ 3 = 4, 4 × 4 = 16."],
      ["Red to blue beads is 2:7. There are 36 beads altogether. How many are red?",["8","28","14","7"],"2 + 7 = 9 parts, 36 ÷ 9 = 4, 2 × 4 = 8."],
      ["$70 is shared in the ratio 2:5. What is the larger share?",["$50","$20","$35","$70"],"2 + 5 = 7 parts, 70 ÷ 7 = 10, 5 × 10 = 50."],
      ["Sweets are shared among 3 children in the ratio 3:2:5. Total is 100. What is the smallest share?",["20","30","50","10"],"3 + 2 + 5 = 10 parts, 100 ÷ 10 = 10, 2 × 10 = 20."],
      ["If A:B = 2:3 and B:C = 3:4, what is A:B:C?",["2:3:4","2:4:3","3:2:4","4:3:2"],"B is the same in both ratios."],
      ["Which ratio is equivalent to 5:8?",["15:24","10:18","5:16","8:5"],"Multiply both by 3."],
      ["3:4 = 12:___. What is the missing number?",["16","9","12","20"],"12 ÷ 3 = 4, 4 × 4 = 16."],
      ["The ratio of apples to oranges is 5:3. There are 25 apples. How many oranges?",["15","10","20","25"],"25 ÷ 5 = 5, 3 × 5 = 15."],
      ["In a class of 24, the ratio of boys to girls is 1:3. How many girls?",["18","6","12","20"],"1 + 3 = 4 parts, 24 ÷ 4 = 6, 3 × 6 = 18."],
      ["The ratio of length to width is 5:2. The length is 20 cm. What is the width?",["8 cm","5 cm","10 cm","4 cm"],"20 ÷ 5 = 4, 2 × 4 = 8."],
      ["Three numbers are in the ratio 2:3:4. Their total is 63. What is the largest?",["28","21","14","36"],"2 + 3 + 4 = 9 parts, 63 ÷ 9 = 7, 4 × 7 = 28."],
      ["Two numbers are in the ratio 4:7. Their difference is 15. What is the smaller number?",["20","35","15","25"],"7 - 4 = 3 parts, 15 ÷ 3 = 5, 4 × 5 = 20."],
      ["A:B = 5:2. If A is 35, what is B?",["14","70","10","25"],"35 ÷ 5 = 7, 2 × 7 = 14."],
      ["Sugar to flour is 1:4. If flour is 600 g, how much sugar?",["150 g","300 g","600 g","100 g"],"600 ÷ 4 = 150."],
      ["Two numbers are in the ratio 3:5. Their total is 64. What is their difference?",["16","32","8","24"],"3 + 5 = 8 parts, 64 ÷ 8 = 8, 2 × 8 = 16."],
      ["8:12 = 2:___. What is the missing number?",["3","4","6","8"],"Simplify 8:12 to 2:3."],
      ["What is 10:25 as a simplified fraction?",["2/5","5/2","10/25","1/5"],"10 ÷ 25 = 2/5."],
      ["The ratio of cats to dogs is 7:3. There are 12 dogs. How many cats?",["28","21","14","7"],"12 ÷ 3 = 4, 7 × 4 = 28."],
      ["Two numbers are in the ratio 2:3. Their total is 45. What is their difference?",["9","18","15","6"],"2 + 3 = 5 parts, 45 ÷ 5 = 9, 1 × 9 = 9."],
      ["A recipe uses 2 cups of water for every 3 cups of rice. For 6 cups of rice, how much water?",["4 cups","3 cups","6 cups","2 cups"],"6 ÷ 3 = 2, 2 × 2 = 4."],
      ["$96 is shared in the ratio 3:5. What is the larger share?",["$60","$36","$48","$96"],"3 + 5 = 8 parts, 96 ÷ 8 = 12, 5 × 12 = 60."],
      ["The ratio of pens to pencils is 3:4. There are 28 pencils. How many pens?",["21","28","14","24"],"28 ÷ 4 = 7, 3 × 7 = 21."]
    ]
  },
  {
    id: "rate-speed",
    title: "Rate and Speed",
    emoji: "🚗",
    blurb: "Unit rate, speed, distance and time.",
    notes: [
      "Speed = Distance ÷ Time.",
      "Distance = Speed × Time."
    ],
    qs: [
      ["What is the formula for speed?",["Distance ÷ Time","Distance × Time","Time ÷ Distance","Distance + Time"],"Speed is how far per unit time."],
      ["A car travels 120 km in 2 hours. What is its speed?",["60 km/h","240 km/h","30 km/h","120 km/h"],"120 ÷ 2 = 60."],
      ["A cyclist rides at 15 km/h for 3 hours. How far?",["45 km","18 km","5 km","15 km"],"15 × 3 = 45."],
      ["A train travels at 80 km/h for 2.5 hours. How far?",["200 km","160 km","82.5 km","40 km"],"80 × 2.5 = 200."],
      ["A car travels 90 km at 30 km/h. How long?",["3 hours","60 hours","2 hours","30 hours"],"90 ÷ 30 = 3."],
      ["A man walks at 5 km/h for 2 hours. How far?",["10 km","7 km","2.5 km","5 km"],"5 × 2 = 10."],
      ["60 km/h is the same as:",["1 km/min","60 km/min","10 km/min","6 km/min"],"60 km in 60 min = 1 km/min."],
      ["120 m/min is the same as:",["2 m/s","120 m/s","6 m/s","0.5 m/s"],"120 ÷ 60 = 2."],
      ["An object moves at 5 m/s for 10 seconds. How far?",["50 m","15 m","0.5 m","500 m"],"5 × 10 = 50."],
      ["A runner runs at 10 m/s for 1 minute. How far?",["600 m","10 m","60 m","100 m"],"1 minute = 60 s, 10 × 60 = 600."],
      ["5 apples cost $3. What is the cost of 1 apple?",["$0.60","$0.50","$1.50","$0.30"],"3 ÷ 5 = 0.60."],
      ["12 books cost $36. What is the cost of 1 book?",["$3","$4","$36","$12"],"36 ÷ 12 = 3."],
      ["A machine fills 500 mL in 2 minutes. What is the rate?",["250 mL/min","1000 mL/min","500 mL/min","100 mL/min"],"500 ÷ 2 = 250."],
      ["At 250 mL/min, how long to fill 1.5 L?",["6 minutes","1.5 minutes","250 minutes","3 minutes"],"1.5 L = 1500 mL, 1500 ÷ 250 = 6."],
      ["A typist types 240 words in 4 minutes. What is the rate?",["60 words/min","240 words/min","40 words/min","960 words/min"],"240 ÷ 4 = 60."],
      ["At 60 words/min, how long to type 900 words?",["15 minutes","9 minutes","60 minutes","54 minutes"],"900 ÷ 60 = 15."],
      ["Speed is 45 km/h and time is 4 hours. Distance?",["180 km","49 km","11.25 km","90 km"],"45 × 4 = 180."],
      ["Distance is 240 km and speed is 60 km/h. Time?",["4 hours","300 hours","180 hours","2 hours"],"240 ÷ 60 = 4."],
      ["A car travels at 70 km/h for 3 hours. Distance?",["210 km","73 km","23.3 km","140 km"],"70 × 3 = 210."],
      ["A car travels 100 km in 2 hours. Speed?",["50 km/h","200 km/h","102 km/h","48 km/h"],"100 ÷ 2 = 50."],
      ["Which is faster?",["90 km/h","20 m/s","72 km/h","They are equal"],"20 m/s = 72 km/h, so 90 km/h is faster."],
      ["A boy runs 3 km in 30 minutes. What is his speed?",["6 km/h","3 km/h","0.1 km/h","90 km/h"],"30 min = 0.5 h, 3 ÷ 0.5 = 6."],
      ["A girl runs 400 m in 50 seconds. Speed?",["8 m/s","20 m/s","0.125 m/s","450 m/s"],"400 ÷ 50 = 8."],
      ["For the same distance, if speed increases, time:",["decreases","increases","stays the same","becomes zero"],"Faster means less time."],
      ["A train covers 300 km in 5 hours. Average speed?",["60 km/h","1500 km/h","305 km/h","55 km/h"],"300 ÷ 5 = 60."]
    ]
  },
  {
    id: "percentage",
    title: "Percentage",
    emoji: "💯",
    blurb: "Percentage of quantities, increase, decrease, discount and original price.",
    notes: [
      "Percent means out of 100.",
      "Increase: multiply by 1 + percentage.",
      "Decrease: multiply by 1 - percentage."
    ],
    qs: [
      ["What is 20% of 80?",["16","20","40","4"],"0.2 × 80 = 16."],
      ["What is 35% of 200?",["70","35","130","65"],"0.35 × 200 = 70."],
      ["What is 12.5% of 80?",["10","12.5","8","20"],"0.125 × 80 = 10."],
      ["What is 125% of 40?",["50","45","40","60"],"1.25 × 40 = 50."],
      ["45 is what percent of 60?",["75%","45%","60%","80%"],"45 ÷ 60 = 0.75."],
      ["18 is 30% of what number?",["60","54","30","18"],"18 ÷ 0.3 = 60."],
      ["Convert 0.375 to a percentage.",["37.5%","3.75%","0.375%","375%"],"Multiply by 100."],
      ["Convert 7/8 to a percentage.",["87.5%","78%","87%","70.8%"],"7 ÷ 8 = 0.875."],
      ["A price of $60 is increased by 15%. New price?",["$69","$75","$66","$70"],"60 × 1.15 = 69."],
      ["A price of $80 is decreased by 25%. New price?",["$60","$55","$65","$20"],"80 × 0.75 = 60."],
      ["A $45 shirt has a 20% discount. Sale price?",["$36","$35","$40","$9"],"45 × 0.8 = 36."],
      ["After a 10% discount, a bag costs $54. Original price?",["$60","$48.60","$59.40","$50"],"54 ÷ 0.9 = 60."],
      ["After a 20% increase, a price is $60. Original price?",["$50","$72","$48","$55"],"60 ÷ 1.2 = 50."],
      ["A 7% service charge is added to $100. Total?",["$107","$170","$100.7","$93"],"100 × 1.07 = 107."],
      ["An 8% tax is added to $25. Total?",["$27","$33","$25.8","$26"],"25 × 1.08 = 27."],
      ["30 out of 120 pupils are absent. What percent are absent?",["25%","30%","20%","35%"],"30 ÷ 120 = 0.25."],
      ["A score of 42 out of 50 is what percentage?",["84%","42%","50%","92%"],"42 ÷ 50 = 0.84."],
      ["55% of 40 pupils are boys. How many boys?",["22","18","55","40"],"0.55 × 40 = 22."],
      ["60% of 120 pupils passed. How many passed?",["72","60","48","100"],"0.6 × 120 = 72."],
      ["Increase 200 by 5%.",["210","205","250","220"],"200 × 1.05 = 210."],
      ["Decrease 500 by 12%.",["440","380","488","450"],"500 × 0.88 = 440."],
      ["A price rises from $50 to $65. Percentage increase?",["30%","15%","25%","35%"],"15 ÷ 50 = 0.3."],
      ["A price falls from $80 to $60. Percentage decrease?",["25%","20%","30%","15%"],"20 ÷ 80 = 0.25."],
      ["15% of a number is 45. What is the number?",["300","67.5","45","150"],"45 ÷ 0.15 = 300."],
      ["A shop sells 80 shirts. 25% are white. How many are not white?",["60","20","40","80"],"25% white means 75% not white, 0.75 × 80 = 60."]
    ]
  },
  {
    id: "circles",
    title: "Circles",
    emoji: "⭕",
    blurb: "Radius, diameter, circumference and area. Use π = 3.14.",
    notes: [
      "Circumference = π × diameter or 2πr.",
      "Area = π × r × r."
    ],
    qs: [
      ["What is the formula for circumference?",["π × diameter","π × radius","radius × radius","diameter ÷ π"],"Circumference is π times diameter."],
      ["A circle has radius 7 cm. What is its diameter?",["14 cm","7 cm","21 cm","3.5 cm"],"Diameter = 2 × radius."],
      ["A circle has diameter 20 cm. What is its radius?",["10 cm","20 cm","40 cm","5 cm"],"Radius = diameter ÷ 2."],
      ["What is the circumference of a circle with diameter 10 cm?",["31.4 cm","78.5 cm","15.7 cm","10 cm"],"3.14 × 10 = 31.4."],
      ["What is the circumference of a circle with radius 5 cm?",["31.4 cm","15.7 cm","78.5 cm","10 cm"],"2 × 3.14 × 5 = 31.4."],
      ["What is the area of a circle with radius 5 cm?",["78.5 cm²","31.4 cm²","25 cm²","157 cm²"],"3.14 × 5 × 5 = 78.5."],
      ["What is the area of a circle with diameter 10 cm?",["78.5 cm²","31.4 cm²","157 cm²","15.7 cm²"],"Radius = 5, area = 78.5."],
      ["What is the circumference of a circle with radius 4 cm?",["25.12 cm","12.56 cm","50.24 cm","8 cm"],"2 × 3.14 × 4 = 25.12."],
      ["What is the area of a circle with radius 4 cm?",["50.24 cm²","25.12 cm²","12.56 cm²","100.48 cm²"],"3.14 × 4 × 4 = 50.24."],
      ["A circle has circumference 62.8 cm. What is its diameter?",["20 cm","10 cm","31.4 cm","40 cm"],"62.8 ÷ 3.14 = 20."],
      ["A circle has circumference 31.4 cm. What is its radius?",["5 cm","10 cm","20 cm","3.14 cm"],"31.4 ÷ 3.14 ÷ 2 = 5."],
      ["What is the area of a circle with radius 10 cm?",["314 cm²","62.8 cm²","31.4 cm²","100 cm²"],"3.14 × 10 × 10 = 314."],
      ["What is the area of a circle with diameter 4 cm?",["12.56 cm²","25.12 cm²","6.28 cm²","50.24 cm²"],"Radius = 2, area = 12.56."],
      ["What is the area of a semicircle with radius 5 cm?",["39.25 cm²","78.5 cm²","15.7 cm²","25 cm²"],"Half of 78.5."],
      ["What is the perimeter of a semicircle with diameter 10 cm?",["25.7 cm","15.7 cm","31.4 cm","20 cm"],"Arc = 15.7, plus diameter 10."],
      ["A wheel has radius 5 cm. How far does it move in one turn?",["31.4 cm","78.5 cm","10 cm","15.7 cm"],"One turn = circumference."],
      ["A wheel has diameter 10 cm. How far in 10 turns?",["314 cm","31.4 cm","100 cm","3140 cm"],"31.4 × 10 = 314."],
      ["If the radius of a circle is doubled, its area becomes:",["4 times","2 times","8 times","same"],"Area depends on radius squared."],
      ["What is the area of a circle with radius 3 cm?",["28.26 cm²","18.84 cm²","9 cm²","56.52 cm²"],"3.14 × 3 × 3 = 28.26."],
      ["What is the circumference of a circle with diameter 6 cm?",["18.84 cm","9.42 cm","37.68 cm","6 cm"],"3.14 × 6 = 18.84."],
      ["The largest possible circle is drawn inside a 10 cm square. What is its area?",["78.5 cm²","100 cm²","31.4 cm²","50 cm²"],"Diameter = 10, radius = 5."],
      ["A circular pond has radius 2 m. What is its area?",["12.56 m²","6.28 m²","4 m²","25.12 m²"],"3.14 × 2 × 2 = 12.56."],
      ["A fence is built around a circular pond of diameter 10 m. How long is the fence?",["31.4 m","78.5 m","10 m","15.7 m"],"Fence is circumference."],
      ["A square of side 10 cm has a circle of radius 5 cm inside. What is the area outside the circle?",["21.5 cm²","78.5 cm²","100 cm²","121.5 cm²"],"100 - 78.5 = 21.5."],
      ["A circle is cut into 4 equal sectors. If radius is 10 cm, what is the area of each sector?",["78.5 cm²","314 cm²","31.4 cm²","157 cm²"],"314 ÷ 4 = 78.5."]
    ]
  },
  {
    id: "angles",
    title: "Angles in Triangles and Quadrilaterals",
    emoji: "📐",
    blurb: "Angle sums, special triangles and quadrilaterals.",
    notes: [
      "Angles in a triangle add to 180°.",
      "Angles in a quadrilateral add to 360°."
    ],
    qs: [
      ["What is the sum of angles in a triangle?",["180°","360°","90°","270°"],"Triangle angle sum is 180°."],
      ["What is the sum of angles in a quadrilateral?",["360°","180°","90°","540°"],"Quadrilateral angle sum is 360°."],
      ["A triangle has angles 50° and 60°. What is the third angle?",["70°","110°","80°","90°"],"180 - 50 - 60 = 70."],
      ["A triangle has angles 90° and 45°. What is the third angle?",["45°","90°","135°","60°"],"180 - 90 - 45 = 45."],
      ["What is each angle in an equilateral triangle?",["60°","90°","45°","30°"],"180 ÷ 3 = 60."],
      ["An isosceles triangle has a top angle of 80°. What is each base angle?",["50°","80°","100°","40°"],"180 - 80 = 100, ÷ 2 = 50."],
      ["An isosceles triangle has base angles of 70°. What is the top angle?",["40°","70°","110°","140°"],"180 - 70 - 70 = 40."],
      ["A right isosceles triangle has one angle 90°. What are the other two?",["45° and 45°","60° and 30°","50° and 40°","90° and 0°"],"Remaining 90° is split equally."],
      ["Three angles of a quadrilateral are 90°, 100° and 80°. What is the fourth?",["90°","80°","100°","110°"],"360 - 270 = 90."],
      ["A parallelogram has one angle 70°. What is the adjacent angle?",["110°","70°","90°","180°"],"Adjacent angles sum to 180°."],
      ["What is each angle in a rectangle?",["90°","60°","45°","120°"],"Rectangles have four right angles."],
