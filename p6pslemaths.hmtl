const QUESTIONS = [];
TOPICS.forEach(topic => {
  topic.qs.forEach((item, index) => {
    QUESTIONS.push({
      id: topic.id + "-" + (index + 1),
      topic: topic.id,
      q: item[0],
      options: item[1],
      exp: item[2]
    });
  });
});

const STORAGE_KEY = "p6MathsFullPack";
const app = document.getElementById("app");

let progress = loadProgress();
let state = {
  questions: [],
  index: 0,
  correct: 0,
  answered: false,
  title: "",
  misses: []
};

function loadProgress() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return { attempts: {}, correct: {}, wrong: [] };
    const data = JSON.parse(raw);
    return {
      attempts: data.attempts || {},
      correct: data.correct || {},
      wrong: data.wrong || []
    };
  } catch (error) {
    return { attempts: {}, correct: {}, wrong: [] };
  }
}

function saveProgress() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
  } catch (error) {}
}

function esc(value) {
  return String(value).replace(/[&<>"']/g, char => {
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char];
  });
}

function shuffle(array) {
  const copy = [...array];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

function prepareQuestions(list) {
  return list.map(q => {
    const optionObjects = q.options.map((text, index) => ({
      text,
      correct: index === 0
    }));
    const shuffled = shuffle(optionObjects);
    return {
      ...q,
      options: shuffled.map(o => o.text),
      answer: shuffled.findIndex(o => o.correct)
    };
  });
}

function getTopic(id) {
  return TOPICS.find(t => t.id === id);
}

function getQuestionsByTopic(id) {
  return QUESTIONS.filter(q => q.topic === id);
}

function getStats() {
  const attempted = Object.keys(progress.attempts).length;
  let totalAttempts = 0;
  let totalCorrect = 0;
  for (const id in progress.attempts) totalAttempts += progress.attempts[id];
  for (const id in progress.correct) totalCorrect += progress.correct[id];
  const accuracy = totalAttempts ? Math.round((totalCorrect / totalAttempts) * 100) : 0;
  return { attempted, accuracy, wrong: progress.wrong.length };
}

function renderHome() {
  const stats = getStats();
  const topicCards = TOPICS.map(topic => {
    const total = topic.qs.length;
    const mastered = QUESTIONS.filter(q => q.topic === topic.id && progress.correct[q.id] > 0).length;
    const percent = total ? Math.round((mastered / total) * 100) : 0;
    return `
      <div class="card topic-card" onclick="openTopic('${topic.id}')">
        <div class="topic-top">
          <div class="emoji">${topic.emoji}</div>
          <div class="chip">P6</div>
        </div>
        <div class="topic-title">${esc(topic.title)}</div>
        <div class="small">${esc(topic.blurb)}</div>
        <div class="progress"><div style="width:${percent}%"></div></div>
        <div class="small">${mastered}/${total} questions correct at least once</div>
      </div>`;
  }).join("");

  app.innerHTML = `
    <div class="container">
      <div class="topbar">
        <div class="brand">🎓 P6 Maths Full Pack</div>
        <div class="chip">250 MCQs</div>
      </div>
      <div class="hero">
        <h1>Primary 6 Maths Practice</h1>
        <p>10 topics × 25 questions. Algebra, ratio, speed, percentage, circles, angles, volume, data and word problems.</p>
        <div class="actions">
          <button class="btn primary" onclick="startAllChallenge()">🌟 Random 20</button>
          <button class="btn primary" onclick="startRandomTen()">🎲 Random 10</button>
          <button class="btn primary" onclick="startWrongAll()">❌ Wrong Replay</button>
          <button class="btn secondary" onclick="resetProgress()">♻️ Reset</button>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><div class="value">${stats.attempted}</div><div class="label">Questions practiced</div></div>
        <div class="stat"><div class="value">${stats.accuracy}%</div><div class="label">Accuracy</div></div>
        <div class="stat"><div class="value">${stats.wrong}</div><div class="label">Wrong questions</div></div>
        <div class="stat"><div class="value">${TOPICS.length}</div><div class="label">Topics</div></div>
      </div>
      ${topicCards}
    </div>`;
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function openTopic(id) {
  const topic = getTopic(id);
  const notesHtml = topic.notes.map(n => `<li>${esc(n)}</li>`).join("");
  app.innerHTML = `
    <div class="container">
      <div class="topbar">
        <button class="btn secondary" onclick="renderHome()">⬅ Home</button>
        <div class="chip">P6 Topic</div>
      </div>
      <div class="card">
        <div class="topic-top">
          <div class="emoji">${topic.emoji}</div>
          <div class="chip">P6</div>
        </div>
        <h2>${esc(topic.title)}</h2>
        <p style="font-weight:800;">${esc(topic.blurb)}</p>
        <h3>Key ideas</h3>
        <ul class="notes">${notesHtml}</ul>
        <div class="actions">
          <button class="btn primary" onclick="startTopic('${topic.id}')">▶️ Start 25 Questions</button>
          <button class="btn secondary" onclick="startTopicWrong('${topic.id}')">❌ Wrong in Topic</button>
        </div>
      </div>
    </div>`;
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function startAllChallenge() {
  startQuiz(shuffle(QUESTIONS).slice(0, 20), "Random 20 Challenge");
}
function startRandomTen() {
  startQuiz(shuffle(QUESTIONS).slice(0, 10), "Random 10");
}
function startWrongAll() {
  const questions = QUESTIONS.filter(q => progress.wrong.includes(q.id));
  if (!questions.length) { alert("No wrong questions saved yet."); return; }
  startQuiz(questions, "Wrong Replay");
}
function startTopic(id) {
  const topic = getTopic(id);
  startQuiz(getQuestionsByTopic(id), topic.title);
}
function startTopicWrong(id) {
  const topic = getTopic(id);
  const questions = QUESTIONS.filter(q => q.topic === id && progress.wrong.includes(q.id));
  if (!questions.length) { alert("No wrong questions in this topic yet."); return; }
  startQuiz(questions, "Wrong Replay: " + topic.title);
}

function startQuiz(list, title) {
  if (!list.length) { alert("No questions available."); return; }
  state = {
    questions: prepareQuestions(list),
    index: 0,
    correct: 0,
    answered: false,
    title,
    misses: []
  };
  renderQuestion();
}

function renderQuestion() {
  const q = state.questions[state.index];
  const topic = getTopic(q.topic);
  const pct = (state.index / state.questions.length) * 100;
  const opts = q.options.map((o, i) =>
    `<button class="option" onclick="answer(${i})">${String.fromCharCode(65+i)}. ${esc(o)}</button>`
  ).join("");

  app.innerHTML = `
    <div class="container">
      <div class="topbar">
        <button class="btn secondary" onclick="renderHome()">🏠 Home</button>
        <div class="chip">${esc(state.title)}</div>
      </div>
      <div class="card">
        <div class="progress"><div style="width:${pct}%"></div></div>
        <div class="small">Question ${state.index+1} of ${state.questions.length} • Score ${state.correct}</div>
        <div class="chip" style="margin:10px 0;">${topic.emoji} ${esc(topic.title)}</div>
        <h2>${esc(q.q)}</h2>
        <div class="options">${opts}</div>
        <div id="feedback" class="feedback hidden"></div>
      </div>
    </div>`;
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function answer(selected) {
  if (state.answered) return;
  state.answered = true;
  const q = state.questions[state.index];
  const buttons = Array.from(document.querySelectorAll(".option"));
  buttons.forEach(b => b.disabled = true);
  buttons[q.answer].classList.add("correct");
  const isCorrect = selected === q.answer;
  if (isCorrect) {
    state.correct++;
    buttons[selected].classList.add("correct");
  } else {
    buttons[selected].classList.add("wrong");
    state.misses.push({ id: q.id, selected });
  }
  updateProgress(q.id, isCorrect);
  const fb = document.getElementById("feedback");
  fb.className = "feedback " + (isCorrect ? "good" : "bad");
  fb.innerHTML = `
    <div>${isCorrect ? "✅ Correct!" : "❌ Not quite."}</div>
    <div class="exp">${esc(q.exp)}${!isCorrect ? " Correct answer: " + esc(q.options[q.answer]) + "." : ""}</div>
    <div class="actions">
      <button class="btn primary" onclick="nextQuestion()">
        ${state.index === state.questions.length - 1 ? "Finish 🏁" : "Next ➜"}
      </button>
    </div>`;
}

function updateProgress(id, isCorrect) {
  progress.attempts[id] = (progress.attempts[id] || 0) + 1;
  if (isCorrect) {
    progress.correct[id] = (progress.correct[id] || 0) + 1;
    progress.wrong = progress.wrong.filter(w => w !== id);
  } else {
    if (!progress.wrong.includes(id)) progress.wrong.push(id);
  }
  saveProgress();
}

function nextQuestion() {
  if (!state.answered) return;
  if (state.index < state.questions.length - 1) {
    state.index++;
    state.answered = false;
    renderQuestion();
  } else {
    finishQuiz();
  }
}

function finishQuiz() {
  const total = state.questions.length;
  const percent = Math.round((state.correct / total) * 100);
  let stars = "💪";
  let msg = "Keep practising! Read the explanations and try again.";
  if (percent >= 90) { stars = "🌟🌟🌟"; msg = "Excellent!"; }
  else if (percent >= 75) { stars = "🌟🌟"; msg = "Great job! Review the missed questions."; }
  else if (percent >= 50) { stars = "🌟"; msg = "Good effort! Focus on the explanations."; }

  const seen = new Set();
  const unique = state.misses.filter(m => {
    if (seen.has(m.id)) return false;
    seen.add(m.id);
    return true;
  });

  const reviewHtml = unique.map(miss => {
    const q = state.questions.find(i => i.id === miss.id);
    const topic = getTopic(q.topic);
    return `
      <div class="review-item">
        <div class="small">${topic.emoji} ${esc(topic.title)}</div>
        <div class="review-q">${esc(q.q)}</div>
        <div class="user-answer">Your answer: ${esc(q.options[miss.selected])}</div>
        <div class="correct-answer">Correct answer: ${esc(q.options[q.answer])}</div>
        <div>${esc(q.exp)}</div>
      </div>`;
  }).join("");

  app.innerHTML = `
    <div class="container">
      <div class="topbar">
        <button class="btn secondary" onclick="renderHome()">🏠 Home</button>
        <div class="chip">Result</div>
      </div>
      <div class="card">
        <h2>${esc(state.title)} Complete!</h2>
        <div class="result-stars">${stars}</div>
        <p style="font-weight:900;">You scored ${state.correct}/${total} (${percent}%). ${msg}</p>
        <div class="actions">
          <button class="btn primary" onclick="renderHome()">🏠 Home</button>
          ${unique.length ? '<button class="btn secondary" onclick="retryWrong()">❌ Retry Wrong</button>' : ""}
        </div>
        <h3>Review</h3>
        ${unique.length ? reviewHtml : "<p>🎉 Perfect! No wrong questions this round.</p>"}
      </div>
    </div>`;
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function retryWrong() {
  const ids = [...new Set(state.misses.map(m => m.id))];
  startQuiz(QUESTIONS.filter(q => ids.includes(q.id)), "Retry Wrong");
}

function resetProgress() {
  if (confirm("Reset all P6 Maths progress?")) {
    progress = { attempts: {}, correct: {}, wrong: [] };
    saveProgress();
    renderHome();
  }
}

renderHome();
</script>
</body>
</html>
